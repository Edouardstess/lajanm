# Template only — real values are injected by the production deployment
# pipeline via secrets manager, never committed and never copied from
# staging or development (NF-24). Production credentials must be rotated
# independently of every other environment.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://__set_by_ci__@production-db-host:5432/lajanm_production
REDIS_URL=redis://production-redis-host:6379
JWT_SECRET=__set_by_secrets_manager__
# Governance note: production MonCash credentials must not be enabled
# until the FSP regulatory status is clarified (see README.md) — until
# then this environment should stay pointed at the sandbox base URL even
# though it's otherwise "production".
MONCASH_BASE_URL=__set_by_secrets_manager__
MONCASH_CLIENT_ID=__set_by_secrets_manager__
MONCASH_CLIENT_SECRET=__set_by_secrets_manager__
MONCASH_WEBHOOK_SECRET=__set_by_secrets_manager__
