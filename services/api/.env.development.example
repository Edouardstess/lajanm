# Copy to .env for local development (docker-compose provides matching postgres/redis).
# NEVER reuse these values, or any real secret, in staging or production.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://lajanm:lajanm_dev_only@localhost:5432/lajanm_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-secret-change-me

# MonCash sandbox credentials (leave unset to develop with top-up
# initiation permanently in the "queued for retry" state).
MONCASH_BASE_URL=https://sandbox.moncashbutton.digicelgroup.com/Api
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
PAYOUT_MAX_AMOUNT_HTG=100000
