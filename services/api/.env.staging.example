# Template only — real values are injected by the staging deployment
# pipeline via secrets manager, never committed. This file documents the
# required keys and MUST use a database/Redis instance fully separate from
# both development and production (NF-24: no shared credentials/data
# between environments).
NODE_ENV=staging
PORT=3000
DATABASE_URL=postgres://__set_by_ci__@staging-db-host:5432/lajanm_staging
REDIS_URL=redis://staging-redis-host:6379
JWT_SECRET=__set_by_secrets_manager__
MONCASH_BASE_URL=https://sandbox.moncashbutton.digicelgroup.com/Api
MONCASH_CLIENT_ID=__set_by_secrets_manager__
MONCASH_CLIENT_SECRET=__set_by_secrets_manager__
MONCASH_WEBHOOK_SECRET=__set_by_secrets_manager__
PAYOUT_MAX_AMOUNT_HTG=100000
CORS_ORIGINS=https://admin-staging.lajanm.example
