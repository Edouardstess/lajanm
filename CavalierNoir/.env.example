# Copiez ce fichier en « .env » et renseignez les valeurs avant `docker compose up`.
# Ce fichier ne doit jamais être versionné avec des valeurs réelles.

# Mot de passe de l'utilisateur sa de SQL Server (8 caractères minimum,
# majuscules, minuscules, chiffres et caractères spéciaux).
SA_PASSWORD=

# Clé de signature des liens porteurs d'identité (exercice quotidien,
# désabonnement). Générez-la, par exemple : openssl rand -base64 48
TOKEN_SIGNING_KEY=

# Compte d'administration créé au premier démarrage.
ADMIN_EMAIL=admin@cavaliernoir.ht
ADMIN_PASSWORD=

# URL publique du site, utilisée dans les courriels et le plan du site.
SITE_BASE_URL=http://localhost:8080

# Transporteur de courriels : « fichier » (développement), « smtp » ou « aucun ».
EMAIL_PROVIDER=fichier
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Étiquette d'image utilisée par docker compose.
TAG=latest
