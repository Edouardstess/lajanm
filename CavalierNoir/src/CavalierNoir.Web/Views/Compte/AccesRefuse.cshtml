@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="section">
    <div class="conteneur conteneur-etroit" style="text-align:center;">
        <p style="font-family:var(--serif);font-size:4rem;color:var(--or);margin:0;">403</p>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        <div class="hero__actions" style="justify-content:center;">
            <a class="bouton bouton--primaire" asp-area="Membre" asp-controller="TableauDeBord" asp-action="Index">Mon espace</a>
            <a class="bouton bouton--contour" asp-controller="Contact" asp-action="Index">Contacter le secrétariat</a>
        </div>
    </div>
</section>
