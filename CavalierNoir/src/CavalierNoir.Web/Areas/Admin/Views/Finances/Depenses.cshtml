@model List<CavalierNoir.Domain.Finance.Expense>
<h1>Dépenses</h1>

<div class="alerte alerte--info">
    <span aria-hidden="true">ℹ</span>
    <span>
        Séparation des tâches : une dépense ne peut pas être approuvée par la personne qui l'a saisie
        (règle SoD-01).
    </span>
</div>

<div class="panneau">
    <h2 class="panneau__titre"><span>Enregistrer une dépense</span></h2>
    <form method="post" asp-action="AjouterDepense">
        <div class="formulaire-grille">
            <div class="champ">
                <label for="categorie">Catégorie</label>
                <select id="categorie" name="categorie">
                    @foreach (var valeur in Enum.GetValues<ExpenseCategory>())
                    {
                        <option value="@valeur">@valeur</option>
                    }
                </select>
            </div>
            <div class="champ">
                <label for="montant">Montant</label>
                <input type="number" id="montant" name="montant" min="0" step="0.01" required />
            </div>
            <div class="champ">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required />
            </div>
            <div class="champ">
                <label for="fournisseur">Fournisseur</label>
                <input type="text" id="fournisseur" name="fournisseur" />
            </div>
        </div>
        <div class="champ">
            <label for="description">Description</label>
            <input type="text" id="description" name="description" required />
        </div>
        <button type="submit" class="bouton bouton--primaire">Enregistrer</button>
    </form>
</div>

<div class="panneau">
    <h2 class="panneau__titre"><span>Historique</span></h2>

    @if (Model.Count == 0)
    {
        <p>Aucune dépense enregistrée.</p>
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Catégorie</th>
                    <th scope="col">Description</th>
                    <th scope="col">Fournisseur</th>
                    <th scope="col" class="nombre">Montant</th>
                    <th scope="col">Approbation</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var depense in Model)
                {
                    <tr>
                        <td>@depense.IncurredOn.ToString("dd/MM/yyyy")</td>
                        <td><span class="etiq etiq--neutre">@depense.Category</span></td>
                        <td>@depense.Description</td>
                        <td>@(depense.Supplier ?? "—")</td>
                        <td class="nombre">@depense.Amount.Format()</td>
                        <td>
                            @if (depense.IsApproved)
                            {
                                <span class="etiq etiq--vert">
                                    Approuvée le @depense.ApprovedAt?.ToLocalTime().ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <form method="post" asp-action="ApprouverDepense" asp-route-id="@depense.Id">
                                    <button type="submit" class="bouton bouton--succes bouton--petit">Approuver</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
