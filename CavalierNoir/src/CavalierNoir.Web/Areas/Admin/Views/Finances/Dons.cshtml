@model List<CavalierNoir.Domain.Finance.Donation>
<h1>Dons</h1>

<div class="panneau">
    <h2 class="panneau__titre"><span>Enregistrer un don</span></h2>
    <form method="post" asp-action="AjouterDon">
        <div class="formulaire-grille">
            <div class="champ">
                <label for="donateur">Donateur</label>
                <input type="text" id="donateur" name="donateur" required />
            </div>
            <div class="champ">
                <label for="courriel">Courriel</label>
                <input type="email" id="courriel" name="courriel" />
            </div>
            <div class="champ">
                <label for="montant">Montant</label>
                <input type="number" id="montant" name="montant" min="0" step="0.01" required />
            </div>
            <div class="champ">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required />
            </div>
        </div>
        <div class="champ">
            <label for="message">Message du donateur</label>
            <input type="text" id="message" name="message" />
        </div>
        <div class="champ champ--case">
            <input type="checkbox" id="anonyme" name="anonyme" value="true" />
            <label for="anonyme">Don anonyme (le nom ne sera pas publié)</label>
        </div>
        <button type="submit" class="bouton bouton--primaire">Enregistrer</button>
    </form>
</div>

<div class="panneau">
    <h2 class="panneau__titre"><span>Historique</span></h2>

    @if (Model.Count == 0)
    {
        <p>Aucun don enregistré.</p>
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Donateur</th>
                    <th scope="col" class="nombre">Montant</th>
                    <th scope="col">Reçu</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var don in Model)
                {
                    <tr>
                        <td>@don.DonatedOn.ToString("dd/MM/yyyy")</td>
                        <td>
                            @(don.IsAnonymous ? "Anonyme" : don.DonorName)
                            @if (!string.IsNullOrWhiteSpace(don.Message))
                            {
                                <br /><span class="carte__meta">@don.Message</span>
                            }
                        </td>
                        <td class="nombre">@don.Amount.Format()</td>
                        <td>@(don.ReceiptNumber ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
