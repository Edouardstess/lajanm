@model IReadOnlyList<CavalierNoir.Domain.Club.Document>
<p class="fil"><a asp-action="Index">Documents</a> › Historique</p>
<h1>Historique du document</h1>

<div class="panneau">
    @if (Model.Count == 0)
    {
        <p>Document introuvable.</p>
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr>
                    <th scope="col" class="nombre">Version</th>
                    <th scope="col">Titre</th>
                    <th scope="col">Publiée le</th>
                    <th scope="col">Taille</th>
                    <th scope="col">État</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var version in Model)
                {
                    <tr>
                        <td class="nombre">v@version.Version</td>
                        <td>@version.Title</td>
                        <td>@version.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@version.SizeLabel</td>
                        <td>
                            <span class="etiq @(version.IsArchived ? "etiq--neutre" : "etiq--vert")">
                                @(version.IsArchived ? "Archivée" : "En vigueur")
                            </span>
                        </td>
                        <td>
                            <a class="bouton bouton--contour bouton--petit" asp-area=""
                               asp-controller="Documents" asp-action="Telecharger" asp-route-id="@version.Id">
                                Télécharger
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
