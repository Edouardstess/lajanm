@model ChangePasswordViewModel
<section class="section">
    <div class="conteneur conteneur-etroit">
        <h1>Changer mon mot de passe</h1>

        <nav class="fil">
            <a asp-action="Index">Profil</a> ·
            <a asp-action="Preferences">Préférences</a> ·
            <a asp-action="MotDePasse">Mot de passe</a> ·
            <a asp-action="Donnees">Mes données</a>
        </nav>

        <div class="panneau">
            <form method="post">
                <div asp-validation-summary="All" class="resume-erreurs"></div>

                <div class="champ">
                    <label asp-for="CurrentPassword"></label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                    <span asp-validation-for="CurrentPassword" class="erreur-champ"></span>
                </div>

                <div class="champ">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="12" />
                    <span class="aide">Douze caractères au minimum, avec majuscule, minuscule, chiffre et caractère spécial.</span>
                    <span asp-validation-for="NewPassword" class="erreur-champ"></span>
                </div>

                <div class="champ">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="erreur-champ"></span>
                </div>

                <div class="actions-formulaire">
                    <button type="submit" class="bouton bouton--primaire">Changer le mot de passe</button>
                </div>
            </form>
        </div>
    </div>
</section>
