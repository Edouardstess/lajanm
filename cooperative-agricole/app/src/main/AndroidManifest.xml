<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".CooperativeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CooperativeAgricole">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Planteurs -->
        <activity
            android:name=".ui.planteur.PlanteurListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.planteur.PlanteurDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.planteur.PlanteurListActivity" />
        <!-- adjustResize : le clavier pousse le formulaire au lieu de le
             recouvrir, les derniers champs restent atteignables. -->
        <activity
            android:name=".ui.planteur.PlanteurFormActivity"
            android:exported="false"
            android:parentActivityName=".ui.planteur.PlanteurListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pesées -->
        <activity
            android:name=".ui.pesee.PeseeListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.pesee.PeseeFormActivity"
            android:exported="false"
            android:parentActivityName=".ui.pesee.PeseeListActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
