<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de l'icône adaptative : aplat de la couleur de marque. Une icône
     d'application se reconnaît de loin par sa couleur et sa silhouette, pas
     par un décor. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1F6F43"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Légère nuance en diagonale, pour éviter l'aplat parfaitement plat. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.06"
        android:pathData="M0,108L108,0v108z" />
</vector>
