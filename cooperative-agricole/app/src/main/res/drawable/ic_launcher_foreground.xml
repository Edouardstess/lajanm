    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tige -->
    <path
        android:pathData="M54,82 V54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Feuille gauche -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,62 C54,62 41,63 34,55 C27,47 29,35 29,35 C29,35 43,36 50,44 C57,52 54,62 54,62 Z" />

    <!-- Feuille droite -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M54,52 C54,52 67,53 74,45 C81,37 79,27 79,27 C79,27 65,28 58,36 C51,44 54,52 54,52 Z" />
</vector>
