<?xml version="1.0" encoding="utf-8"?>
<!-- Formulaire de création / modification d'un planteur. Chaque champ est
     dans un TextInputLayout : c'est lui qui affiche le message d'erreur
     renvoyé par le ViewModel, juste sous le champ concerné. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_retour"
        app:navigationIcon="@drawable/ic_retour"
        app:title="@string/planteur_nouveau" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bloc_code"
                style="@style/ChampTexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/champ_code"
                app:helperText="@string/champ_code_aide"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bloc_prenom"
                style="@style/ChampTexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/champ_prenom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_prenom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bloc_nom"
                style="@style/ChampTexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/champ_nom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_nom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bloc_localite"
                style="@style/ChampTexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/champ_localite"
                app:startIconDrawable="@drawable/ic_localite">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_localite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ non éditable : il ouvre un sélecteur de date, ce qui
                 évite toute saisie de date invalide. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bloc_date_naissance"
                style="@style/ChampTexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/champ_date_naissance"
                app:endIconDrawable="@drawable/ic_calendrier"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champ_date_naissance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/champ_sexe"
                android:textAppearance="@style/Texte.Etiquette" />

            <RadioGroup
                android:id="@+id/groupe_sexe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/sexe_masculin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/champ_sexe_masculin" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/sexe_feminin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/champ_sexe_feminin" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_enregistrer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingVertical="14dp"
                android:text="@string/action_enregistrer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bouton_annuler"
                style="@style/Bouton.Texte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/action_annuler" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
