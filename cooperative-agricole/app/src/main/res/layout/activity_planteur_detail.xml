<?xml version="1.0" encoding="utf-8"?>
<!-- Fiche d'un planteur : ses informations, la synthèse de ses pesées et
     l'historique complet de celles-ci. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barre"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_planteur_detail"
            app:navigationContentDescription="@string/action_retour"
            app:navigationIcon="@drawable/ic_retour"
            app:title="@string/planteur_detail" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="96dp">

                <!-- En-tête : initiales et identité -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/initiales"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/fond_cercle"
                        android:gravity="center"
                        android:textAppearance="@style/Texte.Titre"
                        android:textColor="@color/marque"
                        tools:text="MC" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nom_complet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texte.Titre"
                            tools:text="Marie Carmelle Jean-Baptiste" />

                        <TextView
                            android:id="@+id/sous_titre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Texte.Secondaire"
                            android:textColor="@color/texte_secondaire"
                            tools:text="Féminin · Kenscoff" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Informations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detail_informations"
                    android:textAppearance="@style/Texte.Etiquette" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Carte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <include
                            android:id="@+id/ligne_code"
                            layout="@layout/partie_ligne_information" />

                        <include
                            android:id="@+id/ligne_nom"
                            layout="@layout/partie_ligne_information" />

                        <include
                            android:id="@+id/ligne_localite"
                            layout="@layout/partie_ligne_information" />

                        <include
                            android:id="@+id/ligne_sexe"
                            layout="@layout/partie_ligne_information" />

                        <include
                            android:id="@+id/ligne_naissance"
                            layout="@layout/partie_ligne_information" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Synthèse des pesées -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detail_synthese"
                    android:textAppearance="@style/Texte.Etiquette" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Carte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/valeur_nombre_pesees"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/Texte.Titre"
                                tools:text="3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_nombre_pesees"
                                android:textAppearance="@style/Texte.Detail"
                                android:textColor="@color/texte_secondaire" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Carte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/valeur_poids_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/Texte.Titre"
                                tools:text="131,75 kg" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detail_poids_total"
                                android:textAppearance="@style/Texte.Detail"
                                android:textColor="@color/texte_secondaire" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Carte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendrier"
                            app:tint="@color/texte_secondaire" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/detail_derniere_pesee"
                            android:textAppearance="@style/Texte.Secondaire"
                            android:textColor="@color/texte_secondaire" />

                        <TextView
                            android:id="@+id/valeur_derniere_pesee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texte.Valeur"
                            tools:text="04/09/2026" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Historique -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detail_historique"
                    android:textAppearance="@style/Texte.Etiquette" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liste_pesees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_pesee_compacte" />

                <TextView
                    android:id="@+id/message_aucune_pesee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/detail_aucune_pesee"
                    android:textAppearance="@style/Texte.Secondaire"
                    android:textColor="@color/texte_secondaire"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/bouton_ajouter_pesee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/detail_ajouter_pesee"
        app:icon="@drawable/ic_ajouter" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
