<resources>

    <!--
      Thème unique. Les couleurs sont définies deux fois (values/colors.xml et
      values-night/colors.xml) : le système choisit le jeu adapté au mode clair
      ou sombre, il n'y a donc qu'un thème à maintenir.
    -->
    <style name="Theme.CooperativeAgricole" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marque</item>
        <item name="colorOnPrimary">@color/blanc</item>
        <item name="colorPrimaryContainer">@color/marque_conteneur</item>
        <item name="colorOnPrimaryContainer">@color/marque_sur_conteneur</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/blanc</item>
        <item name="colorSecondaryContainer">@color/accent_conteneur</item>
        <item name="colorOnSecondaryContainer">@color/accent_sur_conteneur</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/texte</item>
        <item name="colorSurfaceVariant">@color/surface_variante</item>
        <item name="colorOnSurfaceVariant">@color/texte_secondaire</item>
        <item name="colorOutline">@color/contour</item>
        <item name="colorOutlineVariant">@color/contour</item>
        <item name="android:colorBackground">@color/fond</item>
        <item name="colorError">@color/erreur</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/fond</item>

        <!-- Composants : réglés une fois ici plutôt que répétés dans chaque
             layout, pour que toute l'application reste cohérente. -->
        <item name="materialCardViewStyle">@style/Carte</item>
        <item name="toolbarStyle">@style/BarreOutils</item>
        <item name="materialButtonStyle">@style/Bouton</item>
        <item name="textInputStyle">@style/ChampTexte</item>
        <item name="floatingActionButtonStyle">@style/BoutonFlottant</item>
        <item name="extendedFloatingActionButtonStyle">@style/BoutonFlottantEtendu</item>
    </style>

    <!-- ============ Typographie ============ -->
    <!-- Une échelle courte et assumée : quatre niveaux de titre, deux de
         corps, une étiquette. Au-delà, les écrans cessent d'avoir l'air de
         venir de la même application. -->

    <style name="Texte.Affichage" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/texte</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Texte.Titre" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texte</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Titre de barre d'outils : assez présent pour ancrer l'écran, assez
         mesuré pour qu'un titre long tienne à côté de la flèche de retour. -->
    <style name="Texte.TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/texte</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/texte</item>
    </style>

    <!-- Les chiffres des compteurs : plus lourds que le texte courant, ils
         doivent se lire d'un coup d'œil. -->
    <style name="Texte.Chiffre" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texte</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.Valeur" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/texte</item>
    </style>

    <style name="Texte.Secondaire" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texte_secondaire</item>
    </style>

    <style name="Texte.Detail" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/texte_secondaire</item>
    </style>

    <!-- Titre de section : capitales espacées, discrètes, jamais en gras — leur
         rôle est de séparer, pas d'attirer l'œil. -->
    <style name="Texte.Etiquette" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/texte_secondaire</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <!-- ============ Composants ============ -->

    <style name="Carte" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/contour</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/marque_conteneur</item>
    </style>

    <style name="BarreOutils" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Texte.TitreBarre</item>
        <item name="titleTextColor">@color/texte</item>
        <item name="subtitleTextAppearance">@style/Texte.Secondaire</item>
        <item name="navigationIconTint">@color/texte</item>
    </style>

    <style name="Bouton" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Bouton.Texte" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ChampTexte" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="ChampTexte.Liste" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="BoutonFlottant" parent="Widget.Material3.FloatingActionButton.Primary" />

    <style name="BoutonFlottantEtendu" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
